{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(sessions/**)",
      "Read(*.session)",
      "Read(*.session-journal)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(docker compose config*)",
      "Bash(docker-compose config*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(docker compose exec * env*)",
      "Bash(docker compose exec * printenv*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker-compose ps*)",
      "Bash(docker-compose logs*)",
      "Bash(bun run lint*)",
      "Bash(bun run type-check*)",
      "Bash(bun run test:run*)",
      "Bash(ruff check*)",
      "Bash(ruff format --check*)"
    ]
  }
}
