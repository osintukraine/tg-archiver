# Build context is the repo root (docker-compose `context: .`). The Dockerfiles
# only COPY shared/python, services/<svc>/{requirements.txt,src} and
# services/frontend/, so everything below is excluded from the context.

# Host-installed dependencies and build output: copying a host node_modules over
# the image's own `bun install` breaks the frontend build (native binaries and
# versions differ), and .next is regenerated by `bun run build`.
**/node_modules
**/.next
**/coverage
**/*.tsbuildinfo
services/frontend/package-lock.json

# Secrets and Telegram sessions never belong in a build context
.env
.env.*
!.env.example
sessions/
**/*.session
**/*.session-journal
**/*.pem
**/*.key

# Python caches and local virtualenvs
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.venv
**/venv

# Repository and tooling metadata
.git
.github
.claude
.playwright-mcp
docs
