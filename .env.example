# tg-archiver Environment Configuration
# Copy this to .env and fill in your values.
# Every variable below is read by the service(s) named in its comment. Hostnames and ports of
# postgres, redis and seaweedfs are fixed inside docker-compose.yml and cannot be set here.
# Secrets (POSTGRES_PASSWORD, MINIO_SECRET_KEY, JWT_SECRET_KEY, JWT_ADMIN_PASSWORD, TELEGRAM_API_HASH)
# must be replaced: compose refuses to start without them and the services refuse these placeholders.
# Check a .env with: python scripts/env_audit.py --env-file .env --strict (names only, never values)

# =============================================================================
# TELEGRAM CREDENTIALS (Required)
# =============================================================================
# Get these from https://my.telegram.org/apps (listener and processor)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
# Session file name under sessions/ (listener)
TELEGRAM_SESSION_NAME=listener

# =============================================================================
# DATABASE
# =============================================================================
# Used by postgres, db-migrate, listener, processor and api
POSTGRES_DB=tg_archiver
POSTGRES_USER=archiver
POSTGRES_PASSWORD=change_me_in_production

# =============================================================================
# OBJECT STORAGE (SeaweedFS S3 gateway; MINIO_* names kept for compatibility)
# =============================================================================
# S3 credentials (seaweedfs, listener, processor, api)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me_at_least_32_chars
# Bucket name (seaweedfs, listener, processor, api). Caddy hardcodes /tg-archive-media, so keep the default
MINIO_BUCKET=tg-archive-media
# Public origin of the site (api, frontend; what browsers and feed readers use). Media links in the API,
# RSS/Atom/JSON feeds and OpenGraph tags become <origin>/media/... (Caddy serves /media/*).
# Also baked into the frontend build as NEXT_PUBLIC_BASE_URL: rebuild it after changing.
PUBLIC_BASE_URL=http://localhost
# Optional: direct public S3 endpoint (e.g. http://localhost:8333 with the port published).
# Leave empty to use the Caddy /media/* route.
MINIO_PUBLIC_URL=
# Delete archived media (S3 object + DB rows; messages stay) older than N days (processor).
# 0 = keep forever. dev: e.g. 3
MEDIA_RETENTION_DAYS=0

# =============================================================================
# REDIS
# =============================================================================
# Redis password for production security (empty = no auth in development; redis, listener, processor, api)
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Auth provider (api): "none" (no auth) or "jwt" (JWT with local users)
AUTH_PROVIDER=jwt
# true = every API endpoint needs a login (private archive); false = public read access
AUTH_REQUIRED=false
# true = RSS/Atom/JSON feeds need a feed token (see Profile > Feed tokens); false = public feeds
FEED_AUTH_REQUIRED=false

# JWT Configuration (api; required when AUTH_PROVIDER=jwt)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_64_char_secret_key_here
JWT_ADMIN_EMAIL=admin@tg-archiver.local
JWT_ADMIN_PASSWORD=change_me_in_production
JWT_EXPIRATION_MINUTES=60

# =============================================================================
# TRANSLATION (Optional)
# =============================================================================
# Enable to translate non-English messages to English (processor; api and frontend show the state)
TRANSLATION_ENABLED=true
# Messages are archived immediately; a background worker translates them afterwards
# (newest first), so a slow or rate-limited provider never delays archiving.
# Provider: deepl (DeepL first if DEEPL_API_KEY is set, then Google), google (Google only) or none
TRANSLATION_PROVIDER=deepl
# DeepL API key (https://www.deepl.com/pro-api). Without it, Google Translate is used.
DEEPL_API_KEY=
# Only set to override the endpoint the deepl library derives from the key
# DEEPL_API_URL=
# Target language and the source languages that get translated (comma-separated)
TRANSLATION_TARGET_LANG=en
TRANSLATION_FROM_LANGUAGES=ru,uk
# Max characters sent to DeepL per UTC day (shared across instances); beyond it Google is
# used until 00:00 UTC. 0 = no cap. Keep it under your DeepL plan's monthly limit / 31.
TRANSLATION_DAILY_CHAR_LIMIT=500000
# Untranslated messages older than this are skipped instead of queued forever
TRANSLATION_MAX_AGE_HOURS=48
# Background worker: messages per batch, idle poll interval, attempts before 'failed'
TRANSLATION_BATCH_SIZE=10
TRANSLATION_POLL_INTERVAL_SECONDS=5
TRANSLATION_MAX_ATTEMPTS=8
# Google Translate (free scraping) is rate limited: minimum pause between calls, and
# exponential backoff after a rate-limit/connection error (doubles from base up to max)
GOOGLE_MIN_INTERVAL_SECONDS=2
GOOGLE_BACKOFF_BASE_SECONDS=30
GOOGLE_BACKOFF_MAX_SECONDS=900

# =============================================================================
# FOLDER-BASED CHANNEL MANAGEMENT
# =============================================================================
# Telegram folder name pattern for channels to archive (listener; api uses it as the default
# folder when promoting a discovered channel)
# Create a folder in Telegram with this name and add channels to it
# Max 12 characters due to Telegram folder name limit
FOLDER_ARCHIVE_ALL_PATTERN=tg-archiver

# =============================================================================
# BACKFILL CONFIGURATION
# =============================================================================
# Listener settings. Enable backfill of historical messages (the api also reads ENABLED and START_DATE)
BACKFILL_ENABLED=true
# Start date for backfill (ISO format: YYYY-MM-DD)
BACKFILL_START_DATE=2024-01-01
# Mode: manual, on_discovery (auto-backfill new channels), scheduled
BACKFILL_MODE=on_discovery
# Messages per batch (rate-limit friendly)
BACKFILL_BATCH_SIZE=100
# Delay between batches in milliseconds
BACKFILL_DELAY_MS=1000
# Media handling: download_available, skip, download_all
BACKFILL_MEDIA_STRATEGY=download_available

# =============================================================================
# SOCIAL DATA FETCHING (Comments & Reactions)
# =============================================================================
# Fetch comments from discussion groups and reactions from messages.
# Uses Telegram API: GetDiscussionMessage, GetMessagesReactions
# Data displayed in the Social Graph tab of message detail view.

# Enable/disable social data fetching entirely
SOCIAL_FETCH_ENABLED=true

# Only fetch social data for messages from the last N days
# Older messages won't have their comments/reactions updated
SOCIAL_FETCH_PERIOD_DAYS=7

# How often to run the fetch cycle (in seconds)
# Each cycle processes SOCIAL_FETCH_BATCH_SIZE messages
SOCIAL_FETCH_INTERVAL_SECONDS=300

# Number of messages to process per fetch cycle
# Higher = more API calls, lower = slower catch-up
SOCIAL_FETCH_BATCH_SIZE=50

# Seconds between reaction polls for visible messages (Telegram recommends 15-30)
SOCIAL_REACTION_POLL_INTERVAL=30

# =============================================================================
# DISCOVERED CHANNEL JOINING
# =============================================================================
# Forwarded posts from channels you do not monitor are recorded as "discovered".
# Joining them lets the listener fetch social data, but each join is an action
# by your Telegram account, so it is gated.
#
# CHANNEL_JOIN_MODE:
#   approval - only join channels an admin approved (Admin > Channels > Discovered)
#   auto     - join every discovered channel automatically
#   off      - never join (discovery/recording continues)
CHANNEL_JOIN_MODE=approval

# Deprecated: CHANNEL_JOIN_ENABLED=false is treated as CHANNEL_JOIN_MODE=off
CHANNEL_JOIN_ENABLED=true

# Seconds between join cycles, and max channels attempted per cycle
CHANNEL_JOIN_INTERVAL_SECONDS=60
CHANNEL_JOIN_BATCH_SIZE=5

# Failed joins retry up to MAX_RETRIES times, waiting RETRY_DELAY_HOURS between tries
CHANNEL_JOIN_MAX_RETRIES=3
CHANNEL_JOIN_RETRY_DELAY_HOURS=24

# Max successful joins per rolling 24 hours (protects the account from flood limits)
CHANNEL_JOIN_DAILY_CAP=20

# Hours to pause joining after Telegram says the account is in too many channels
CHANNEL_JOIN_LIMIT_PAUSE_HOURS=24

# =============================================================================
# PROCESSOR RETRIES
# =============================================================================
# A message that fails processing stays pending and is redelivered after this
# idle time (milliseconds). After 3 failed deliveries it goes to the dead-letter
# queue (Redis stream telegram:messages:dlq), viewable and replayable via
# GET/POST /api/admin/dlq.
PROCESSOR_RETRY_IDLE_MS=300000

# =============================================================================
# GAP DETECTION (fills gaps from downtime)
# =============================================================================
# Listener. On startup and periodically, backfill channels that have been silent too long
GAP_DETECTION_ENABLED=true
# Hours without a message before a channel is checked for a gap
GAP_THRESHOLD_HOURS=1.0
# Seconds between periodic gap checks, and max channels backfilled per check
GAP_CHECK_INTERVAL_SECONDS=600
GAP_MAX_CHANNELS_PER_CHECK=10

# =============================================================================
# LOGGING AND API (Optional)
# =============================================================================
# Log level and format for listener, processor and api. LOG_FORMAT: json or console
LOG_LEVEL=INFO
LOG_FORMAT=json
# Site name used in feed generator and author fields (api)
PLATFORM_NAME=Telegram Archiver
# Browser origins allowed to call the API cross-origin (api, comma-separated).
# Not needed behind Caddy on one origin; set it for a separate frontend origin
API_CORS_ORIGINS=http://localhost:3000
# Hosts whose X-Forwarded-* headers the api trusts (comma-separated; the bundled Caddy is "caddy")
TRUSTED_PROXY_HOSTS=caddy,127.0.0.1,localhost

# =============================================================================
# FRONTEND
# =============================================================================
# API URL for client-side requests (frontend, baked in at build time)
# - Empty string: Use relative URLs (when behind Caddy/nginx proxy)
# - http://localhost:8000: Direct API access (development without proxy)
NEXT_PUBLIC_API_URL=

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================
# Enable external RSS news ingestion feature
# When true: Shows News page, admin RSS feeds management, immersive RSS ticker
# When false: Hides all external RSS news features (native RSS output still works)
NEXT_PUBLIC_RSS_ENABLED=false

# Cloudflare Turnstile captcha on the public "Suggest a channel" form.
# Leave both empty to use Cloudflare's always-pass test key (no real captcha;
# the endpoint is then protected only by CSRF and a 3/min per-IP rate limit).
# The site key is baked in at build time: rebuild the frontend after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# SECURITY (Production)
# =============================================================================
# Environment mode (api): "development" or "production"
# Affects: cookie secure flag, HTTPS enforcement
ENVIRONMENT=development

# CSRF protection (double-submit cookie pattern)
# Enabled by default (the bundled frontend sends X-CSRF-Token). Only set to false for debugging.
CSRF_ENABLED=true

# Token blacklist behavior when Redis is unavailable
# "open" = allow requests (availability over security)
# "closed" = deny requests (security over availability)
TOKEN_BLACKLIST_FAIL_MODE=open
